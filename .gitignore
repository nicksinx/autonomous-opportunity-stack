# Transient cutover diagnostics — keep on disk for forensics, not in repo.
# Each cutover step generated many timestamped attempts; we commit only the
# canonical PASS artifacts referenced in SPRINT_CLOSEOUT.md (negated below).
backups/n8n/execution-*-inspection-*.json
backups/n8n/step10-attempt-*.json
backups/n8n/step10-execution-failure-*.json
backups/n8n/step10-main-workflows-update-*.json
backups/n8n/step10-execution-chain-*.json
backups/n8n/step11-execution-audit-*.json
backups/n8n/step11-diagnostics-*.json
backups/n8n/workflow-audit-*.json
backups/n8n/workflow-deletion-review-*.md
backups/n8n/cutover-report-*.json
backups/n8n/wf_collect_trends-live-order-patch-*.json
backups/n8n/step11-postgres-verification-*.json
