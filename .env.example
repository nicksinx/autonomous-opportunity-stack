# Copy to .env and fill in. Dotenv is loaded by n8n/import-workflows.mjs and related scripts.
# See also: .env.postgres.example (Postgres only).
#
# Do not use placeholder self-echo lines like N8N_API_URL=N8N_API_URL — scripts resolve them as hostnames.

# n8n Public API (import-workflows.mjs, simulate, etc.) — must be a full URL with scheme.
# Example: http://127.0.0.1:5678
N8N_API_URL=http://127.0.0.1:5678
# Optional alternate base URL (phase1-gate falls back if N8N_API_URL / N8N_BASE_URL unset — e.g. match .cursor/mcp.json)
# N8N_MCP_URL=http://127.0.0.1:5678
# Create in n8n: Settings → n8n API → Create API key (workflow scope + workflow:execute for Gate 5)
N8N_API_KEY=

# Optional — Gate 5 only if your n8n has no POST /api/v1/workflows/{id}/execute yet (REST fallback).
# Copy Cookie / browser-id from DevTools → Network when you click "Execute workflow" in the Editor.
# Or reuse session JWT as N8N_MCP_TOKEN (same idea as MCP; not the same as N8N_API_KEY unless you use one key for both).
# N8N_SESSION_COOKIE=n8n-auth=...
# N8N_MCP_TOKEN=
# Required with session JWT (copy from the same Network request as Execute workflow):
# N8N_BROWSER_ID=
# N8N_MCP_BROWSER_ID=
