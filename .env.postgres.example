# POD Trend Research — Postgres connection settings.
# Copy to .env.postgres (git-ignored) and fill in real role passwords.
# See db/README.md for full setup, rotation, and backup notes.

# App role: full CRUD on `public`. Used by n8n nodes, scripts at runtime.
# Host shell:                use 127.0.0.1:5433
# Container on pod_local_net: use local-postgres:5432
DATABASE_URI=postgresql://pod_app:postgres@127.0.0.1:5433/pod_trends

# Admin role: superuser of pod_trends. Used by run_migrations.mjs and
# backfill_sheets_to_pg.mjs. Never wire this into n8n credentials.
DATABASE_URI_ADMIN=postgresql://pod_admin:YOUR_PASSWORD@127.0.0.1:5433/pod_trends
N8N_API_URL=http://localhost:5678
N8N_API_KEY=n8n-api-key
N8N_MCP_URL=http://localhost:5678
N8N_MCP_API_KEY=n8n-mcp-api-key
# Optional libpq-style fallbacks (for psql, pg_dump, etc.).
PGHOST=127.0.0.1
PGPORT=5433
PGDATABASE=pod_trends
PGUSER=pod_app
