      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH rows AS (\n  SELECT signal_id, date_collected, source, market, term, related_term, category, signal_type, velocity_hint, url, raw_payload_json\n  FROM raw_signals\n  WHERE date_collected::date = CURRENT_DATE\n)\nSELECT * FROM rows\nUNION ALL\nSELECT '__empty__' AS signal_id, NOW() AS date_collected, '' AS source, '' AS market, '' AS term, '' AS related_term, '' AS category, '' AS signal_type, '' AS velocity_hint, '' AS url, '{}'::jsonb AS raw_payload_json\nWHERE NOT EXISTS (SELECT 1 FROM rows)",
          "options": {}
        },
        "id": "c3000003-0003-4003-8003-000000000022",
        "name": "Read raw_signals",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          220,
          0
        ],
        "credentials": {
          "postgres": {
            "name": "Postgres - POD Research"
          }
        }
      },
      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH rows AS (\n  SELECT canonical_id, canonical_term, aliases, status\n  FROM normalized_terms\n)\nSELECT * FROM rows\nUNION ALL\nSELECT '' AS canonical_id, '' AS canonical_term, '' AS aliases, '' AS status\nWHERE NOT EXISTS (SELECT 1 FROM rows)",
          "options": {}
        },
        "id": "c3000003-0003-4003-8003-000000000023",
        "name": "Read normalized_terms",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          440,
          0
        ],
        "credentials": {
          "postgres": {
            "name": "Postgres - POD Research"
          }
        }
