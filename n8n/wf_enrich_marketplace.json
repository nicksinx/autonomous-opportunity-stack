      {
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH rows AS (\n  SELECT evidence_id, canonical_id, source, phrase, captured_at\n  FROM marketplace_evidence\n  WHERE captured_at >= CURRENT_DATE - INTERVAL '7 days'\n)\nSELECT * FROM rows\nUNION ALL\nSELECT '' AS evidence_id, '' AS canonical_id, '' AS source, '' AS phrase, NOW() AS captured_at\nWHERE NOT EXISTS (SELECT 1 FROM rows)",
          "options": {}
        },
        "id": "c3000003-0003-4003-8003-000000000024",
        "name": "Read marketplace_evidence",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          660,
          0
        ],
        "credentials": {
          "postgres": {
            "name": "Postgres - POD Research"
          }
        }
      },
      {
        "parameters": {
          "mode": "runOnceForAllItems",
          "language": "javaScript",
          "jsCode": "const rawSignals = $('Read raw_signals').all().map((it) => it.json || {});\nconst normalizedRows = $('Read normalized_terms').all().map((it) => it.json || {});\nconst existingRows = $('Read marketplace_evidence').all().map((it) => it.json || {}).filter((row) => String(row.evidence_id || '').trim());\nconst existing = new Set(\n  existingRows.map((row) => String(row.evidence_id || '').trim()).filter(Boolean),\n);\n\nfunction slugify(text) {\n  return String(text || '')\n    .toLowerCase()\n    .replace(/[^a-z0-9]+/g, '_')\n    .replace(/^_+|_+$/g, '')\n    .slice(0, 80);\n}\n\nfunction normalizeText(text) {\n  return String(text || '').replace(/\\s+/g, ' ').trim();\n}\n\nconst canonicalMap = new Map();\nfor (const row of normalizedRows) {\n  const canonicalId = String(row.canonical_id || '').trim();\n  if (!canonicalId) continue;\n  const canonicalTerm = normalizeText(row.canonical_term || canonicalId.replace(/^norm_/, ''));\n  canonicalMap.set(canonicalTerm.toLowerCase(), canonicalId);\n  const aliases = normalizeText(row.aliases);\n  if (aliases) {\n    for (const alias of aliases.split('|')) {\n      const key = normalizeText(alias).toLowerCase();\n      if (key) canonicalMap.set(key, canonicalId);\n    }\n  }\n}\n\nfunction resolveCanonicalId(term) {\n  const key = normalizeText(term).toLowerCase();\n  return canonicalMap.get(key) || null;\n}\n\nconst out = [];\nfor (const raw of rawSignals) {\n  const signalId = String(raw.signal_id || '').trim();\n  const term = normalizeText(raw.term);\n  if (!term || signalId === 'ERROR' || term.toLowerCase() === 'fetch_failed') continue;\n\n  const canonicalId = resolveCanonicalId(term);\n  if (!canonicalId) continue;\n\n  const source = normalizeText(raw.source);\n  const evidenceId = 'ev_' + slugify(signalId || term);\n  if (existing.has(evidenceId)) continue;\n\n  out.push({\n    json: {\n      evidence_id: evidenceId,\n      canonical_id: canonicalId,\n      source: source || 'unknown',\n      phrase: term,\n      product_type: source === 'etsy_autocomplete' ? 't-shirt|mug|sticker' : 't-shirt|sticker',\n      intent_type: source === 'etsy_autocomplete' ? 'buyer_intent' : 'trend_interest',\n      evidence_strength: source === 'etsy_autocomplete' ? 0.9 : 0.55,\n      captured_at: normalizeText(raw.date_collected) || new Date().toISOString(),\n    },\n  });\n}\n\nif (!out.length) {\n  const now = new Date().toISOString();\n  return [\n    {\n      json: {\n        __noRows: true,\n        run_id: 'run_wf_enrich_marketplace_' + Date.now(),\n        run_started: now,\n        run_finished: now,\n        job_name: 'wf_enrich_marketplace',\n        rows_added: 0,\n        rows_updated: 0,\n        status: 'success',\n        error_log: '',\n      },\n    },\n  ];\n}\n\nreturn out;"
        },
