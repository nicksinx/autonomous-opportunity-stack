        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO score_weights (dimension, weight, enabled, last_updated, notes)\nSELECT * FROM jsonb_to_recordset($1::jsonb)\n  AS t(dimension text, weight numeric, enabled boolean, last_updated timestamptz, notes text)\nON CONFLICT (dimension) DO UPDATE SET\n  weight = EXCLUDED.weight, enabled = EXCLUDED.enabled, last_updated = EXCLUDED.last_updated, notes = EXCLUDED.notes",
          "options": {
            "queryReplacement": "={{ JSON.stringify($json.weight_rows || []) }}"
          }
        },
