        },
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO performance_feedback\n  (feedback_id, opp_id, brief_id, product_sku, feedback_date, units_sold_30d, revenue_30d,\n   gross_margin_pct, return_rate_pct, ctr_pct, conversion_rate_pct, feedback_notes)\nSELECT * FROM jsonb_to_recordset($1::jsonb)\n  AS t(feedback_id text, opp_id text, brief_id text, product_sku text, feedback_date date,\n       units_sold_30d int, revenue_30d numeric, gross_margin_pct numeric, return_rate_pct numeric,\n       ctr_pct numeric, conversion_rate_pct numeric, feedback_notes text)\nON CONFLICT (feedback_id) DO NOTHING",
          "options": {
            "queryReplacement": "={{ JSON.stringify($json.records || []) }}"
          }
        },
        "id": "f9-104",
        "name": "4. Insert feedback ON CONFLICT DO NOTHING",
